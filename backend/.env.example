# Cadena de conexión para conectarse a MySQL.
# Formato: mysql://USUARIO:CONTRASEÑA@localhost:3306/sistema_inventario
DATABASE_URL=

# Puerto donde va a arrancar el servidor
PORT=3000
# development en tu computadora; production en el servidor real
NODE_ENV=development

# AUTENTICACIÓN (Seguridad con JWT)
# Llave para firmar el token de acceso. Usa un texto largo y aleatorio.
JWT_ACCESS_SECRET=
# Tiempo que dura vivo el token de acceso.
JWT_ACCESS_EXPIRES_IN="15m"

# SESIÓN (refresh token en cookie httpOnly; ya no es JWT, no necesita llave)
# Minutos sin renovar para que la sesión muera (red de seguridad si el navegador no cerró sesión)
SESSION_IDLE_MINUTES="30"
# Máximo de horas por jornada desde el login, aunque la usen sin parar
SESSION_MAX_HOURS="12"
# Máximo de sesiones abiertas a la vez por usuario; al pasarse, se cierra la más vieja
MAX_SESSIONS_PER_USER="5"
# "true" solo cuando el sistema corra con HTTPS.
COOKIE_SECURE="false"
# "strict" si frontend y backend comparten dominio; "none" si están en dominios distintos (exige COOKIE_SECURE="true").
COOKIE_SAMESITE="strict"

# CORS: vacío si frontend y backend comparten dominio (proxy de Vite o nginx).
# Si el frontend vive en otro dominio, pon su URL (varias separadas por coma).
CORS_ORIGINS="http://localhost:5173"

# Usuario administrador que crea el seed (npx prisma db seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=