# Copia este archivo como .env (en la misma carpeta backend/) y llena los valores.
# El .env NUNCA se sube a git; este .env.example sí (sin valores secretos).

# BASE DE DATOS
# Formato: mysql://USUARIO:CONTRASEÑA@localhost:3306/sistema_inventario
DATABASE_URL=

# SERVIDOR
# Puerto donde arranca el backend
PORT=3000
# development | production
NODE_ENV=development

# AUTENTICACIÓN (JWT)
# Llave para firmar el token de acceso. Usa un texto largo y aleatorio.
JWT_ACCESS_SECRET=
# Llave para firmar el token de renovación (refresh token). Distinta a la anterior.
JWT_REFRESH_SECRET=
# Duración del token de acceso
JWT_ACCESS_EXPIRES_IN="15m"
# Duración del token de renovación
JWT_REFRESH_EXPIRES_IN="30m"

# CORS (Frontend)
FRONTEND_URL="http://localhost:5173"

# PRIMER USUARIO ADMINISTRADOR (lo crea: npx prisma db seed)
# Solo se usa si ese usuario todavía no existe. Usuario en minúsculas; contraseña de al menos 8 caracteres.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
