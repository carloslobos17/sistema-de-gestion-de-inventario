// ==========================================
// CONFIGURACIÓN DE PRISMA
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS GLOBALES
// ==========================================
enum PaymentType {
  Cash
  Credit
}

enum PaymentMethod {
  Cash
  Transfer
}

enum AccountStatus {
  Pending
  PartiallyPaid
  Paid
  Overdue
  Voided
}

enum CashRegisterStatus {
  Open
  Closed
}

enum MovementType {
  In
  Out
  Adjustment
}

enum TransactionType {
  Income
  Expense
}

enum FinancialAccountType {
  Bank
  CashRegister
}

// ==========================================
// MÓDULO DE SEGURIDAD Y ACCESO
// ==========================================
model Role {
  id                   Int     @id @default(autoincrement())
  name                 String  @db.VarChar(255)
  can_manage_structure Boolean @default(false)

  users User[]

  @@map("roles")
}

model User {
  id            Int      @id @default(autoincrement())
  role_id       Int
  username      String   @unique @db.VarChar(100)
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  role          Role          @relation(fields: [role_id], references: [id])
  refresh_token RefreshToken?

  @@index([is_active, created_at]) // listado paginado: filtra por estado, ordena por fecha
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  token      String   @unique @db.VarChar(512)
  expires_at DateTime
  is_revoked Boolean  @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// MÓDULO DE DATOS MAESTROS Y CATÁLOGOS
// ==========================================
model Category {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(100)
  is_active Boolean @default(true)

  @@index([is_active, name]) // listado paginado y /options: filtra por estado, ordena por nombre
  @@map("categories")
}

model Brand {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(100)
  is_active Boolean @default(true)

  @@index([is_active, name]) // listado paginado y /options: filtra por estado, ordena por nombre
  @@map("brands")
}

model UnitOfMeasure {
  id   Int    @id // código de Hacienda (ej. 34 = Kilogramo, 59 = Unidad)
  name String @unique @db.VarChar(50)

  @@map("units_of_measure")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  company_name String   @unique @db.VarChar(200)
  contact_name String?  @db.VarChar(150) // persona de contacto en la empresa (ej. el vendedor que los atiende)
  phone        String?  @unique @db.VarChar(50)
  email        String?  @unique @db.VarChar(150)
  address      String?  @db.VarChar(255)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  @@index([is_active, company_name]) // listado paginado y /options
  @@map("suppliers")
}

model Customer {
  id              Int      @id @default(autoincrement())
  first_name      String   @db.VarChar(100)
  last_name       String   @db.VarChar(100)
  document_number String?  @unique @db.VarChar(50)
  phone           String?  @unique @db.VarChar(50)
  email           String?  @unique @db.VarChar(150)
  address         String?  @db.VarChar(255)
  credit_limit    Decimal  @default(0) @db.Decimal(12, 2) // 0 = sin crédito; cada cliente tiene el suyo
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  @@index([is_active, last_name, first_name]) // listado paginado ordenado por apellido
  @@map("customers")
}
