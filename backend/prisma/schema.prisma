// ==========================================
// CONFIGURACIÓN DE PRISMA
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS GLOBALES
// ==========================================
enum OperationCondition {
  Cash
  Credit
  Other
}

enum AccountStatus {
  Pending
  PartiallyPaid
  Paid
  Overdue
  Voided
}

enum CashRegisterStatus {
  Open
  Closed
}

enum MovementType {
  In
  Out
  Adjustment
}

enum TransactionType {
  Income
  Expense
}

enum FinancialAccountType {
  Bank
  CashRegister
}

// Tipo de documento de identificación (mismos valores que pide la factura electrónica)
enum DocumentType {
  NIT
  DUI
  PASSPORT
  RESIDENT_CARD
  OTHER
}

// Contribuyente: inscrito en IVA (tiene NRC). Sujeto excluido: informal, sin NRC.
enum SupplierType {
  Taxpayer
  ExcludedSubject
}

// Consumidor final: se le emite Factura. Contribuyente: inscrito en IVA, se le puede emitir CCF.
enum CustomerType {
  FinalConsumer
  Taxpayer
}

// Género del cliente (opcional, solo informativo: Hacienda no lo pide)
enum Gender {
  M
  F
}

// ==========================================
// MÓDULO DE SEGURIDAD Y ACCESO
// ==========================================
model Role {
  id                   Int     @id @default(autoincrement())
  name                 String  @db.VarChar(255)
  can_manage_structure Boolean @default(false)

  users User[]

  @@map("roles")
}

model User {
  id            Int      @id @default(autoincrement())
  role_id       Int
  username      String   @unique @db.VarChar(100)
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  role          Role          @relation(fields: [role_id], references: [id])
  refresh_token RefreshToken?

  @@index([is_active, created_at]) // listado paginado: filtra por estado, ordena por fecha
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  token      String   @unique @db.VarChar(512)
  expires_at DateTime
  is_revoked Boolean  @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// MÓDULO DE DATOS MAESTROS Y CATÁLOGOS
// ==========================================
model Category {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(100)
  is_active Boolean @default(true)

  @@index([is_active, name]) // listado paginado y /options: filtra por estado, ordena por nombre
  @@map("categories")
}

model Brand {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(100)
  is_active Boolean @default(true)

  @@index([is_active, name]) // listado paginado y /options: filtra por estado, ordena por nombre
  @@map("brands")
}

// Catálogo fijo del Ministerio de Hacienda (CAT-014 "Unidad de Medida" del DTE).
// No tiene CRUD: los datos se cargan en la migración. El id ES el código oficial de Hacienda.
model UnitOfMeasure {
  id   Int    @id // código de Hacienda (ej. 34 = Kilogramo, 59 = Unidad)
  name String @unique @db.VarChar(50)

  @@map("units_of_measure")
}

// ==========================================
// CATÁLOGOS DE HACIENDA (DTE)
// ==========================================
// Fijos: se cargan con prisma/seeds/locations.seed.ts y no tienen CRUD.
// División territorial vigente: departamento → municipio → distrito.

model Department {
  code String @id @db.Char(2) // código de Hacienda (ej. "14" = La Unión)
  name String @db.VarChar(50)

  municipalities Municipality[]

  @@map("departments")
}

model Municipality {
  id              Int    @id @default(autoincrement())
  department_code String @db.Char(2)
  code            String @db.Char(2) // código de Hacienda; solo es único dentro de su departamento
  name            String @db.VarChar(50)

  department Department @relation(fields: [department_code], references: [code])
  districts  District[]

  @@unique([department_code, code])
  @@map("municipalities")
}

model District {
  id              Int    @id @default(autoincrement())
  municipality_id Int
  code            String @db.Char(2) // código de Hacienda; solo es único dentro de su municipio
  name            String @db.VarChar(50)

  municipality Municipality @relation(fields: [municipality_id], references: [id])
  suppliers    Supplier[]
  customers    Customer[]

  @@unique([municipality_id, code])
  @@map("districts")
}

// Catálogo CAT-019 "Actividad Económica" de Hacienda. Fijo: se carga con prisma/seeds/economicActivities.seed.ts.
model EconomicActivity {
  code String @id @db.Char(5) // código de Hacienda (ej. "47522" = Venta al por menor de artículos de ferretería)
  name String @db.VarChar(200)

  suppliers Supplier[]
  customers Customer[]

  @@map("economic_activities")
}

// CAT-017 Forma de pago (Hacienda). Solo lectura: se carga con el seed.
model PaymentMethod {
  code String @id @db.Char(2) // "01"... "99" (es el paymentCode de la factura)
  name String @unique @db.VarChar(100)

  @@map("payment_methods")
}

model Supplier {
  id                     Int          @id @default(autoincrement())
  supplier_type          SupplierType
  name                   String       @unique @db.VarChar(200) // nombre o nombre comercial
  legal_name             String?      @db.VarChar(200) // razón social (solo contribuyentes)
  document_type          DocumentType
  document_number        String       @db.VarChar(20) // NIT y DUI solo con dígitos; pasaporte/carné tal cual (mayúsculas)
  nrc                    String?      @unique @db.VarChar(8) // solo contribuyentes, solo dígitos
  economic_activity_code String?      @db.Char(5) // solo contribuyentes
  district_id            Int
  address                String       @db.VarChar(255)
  phone                  String?      @db.VarChar(50) // obligatorio para sujetos excluidos
  phone_alt              String?      @db.VarChar(50)
  email                  String       @db.VarChar(150)
  contact_name           String?      @db.VarChar(150) // persona de contacto (solo contribuyentes)
  applies_perception     Boolean      @default(false) // nos cobra percepción de IVA (1 %) al vendernos
  is_active              Boolean      @default(true)
  created_at             DateTime     @default(now())

  district          District          @relation(fields: [district_id], references: [id])
  economic_activity EconomicActivity? @relation(fields: [economic_activity_code], references: [code])

  @@unique([document_type, document_number])
  @@index([is_active, name]) // listado paginado y /options
  @@map("suppliers")
}

// Clientes. Reglas según el tipo:
//   - Consumidor final: solo el nombre es obligatorio (documento, ubicación y correo opcionales).
//   - Contribuyente: NIT o DUI, NRC, actividad económica, distrito, dirección y correo obligatorios.
model Customer {
  id                     Int           @id @default(autoincrement())
  customer_type          CustomerType
  name                   String        @db.VarChar(200) // nombre completo o razón social (NO único: puede haber dos "Juan Pérez")
  trade_name             String?       @db.VarChar(200) // nombre comercial (solo contribuyentes)
  gender                 Gender?
  document_type          DocumentType?
  document_number        String?       @db.VarChar(20) // NIT y DUI solo con dígitos; pasaporte/carné tal cual (mayúsculas)
  nrc                    String?       @unique @db.VarChar(8) // solo contribuyentes, solo dígitos
  economic_activity_code String?       @db.Char(5) // solo contribuyentes
  district_id            Int? // obligatorio para contribuyentes
  address                String?       @db.VarChar(255)
  phone                  String?       @db.VarChar(50)
  phone_alt              String?       @db.VarChar(50)
  email                  String?       @db.VarChar(150) // obligatorio para contribuyentes (ahí llega el DTE)
  credit_limit           Decimal       @default(0) @db.Decimal(12, 2) // 0 = sin crédito; solo lo cambia can_manage_structure
  is_active              Boolean       @default(true)
  created_at             DateTime      @default(now())

  district          District?         @relation(fields: [district_id], references: [id])
  economic_activity EconomicActivity? @relation(fields: [economic_activity_code], references: [code])

  @@unique([document_type, document_number]) // MySQL permite varios NULL: los clientes sin documento no chocan
  @@index([is_active, name]) // listado paginado ordenado por nombre
  @@map("customers")
}
