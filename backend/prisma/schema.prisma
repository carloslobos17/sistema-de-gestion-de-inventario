// ==========================================
// CONFIGURACIÓN DE PRISMA
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS GLOBALES
// ==========================================
enum TipoPago {
  Contado
  Credito
}

enum MetodoPago {
  Efectivo
  Transferencia
}

enum EstadoCuenta {
  Pendiente
  Abonada
  Pagada
  Vencida
  Anulada
}

enum EstadoCaja {
  Abierta
  Cerrada
}

enum TipoMovimiento {
  Entrada
  Salida
  Ajuste
}

enum TipoTransaccion {
  Ingreso
  Egreso
}

enum TipoCuentaFinanciera {
  Banco
  CajaFisica
}

// ==========================================
// MÓDULO DE SEGURIDAD Y ACCESO
// ==========================================
model Rol {
  id                  Int       @id @default(autoincrement())
  nombre              String    @db.VarChar(255)
  modifica_estructura Boolean   @default(false)

  usuarios            Usuario[]

  @@map("roles")
}

model Usuario {
  id             Int           @id @default(autoincrement())
  rol_id         Int
  nombre_usuario String        @unique @db.VarChar(100)
  nombre         String        @db.VarChar(100)
  apellido       String        @db.VarChar(100)
  password_hash  String        @db.VarChar(255)
  activo         Boolean       @default(true)
  fecha_creacion DateTime      @default(now())

  rol           Rol           @relation(fields: [rol_id], references: [id])
  refresh_token RefreshToken?

  @@map("usuarios")
}
model RefreshToken {
  id               Int      @id @default(autoincrement())
  usuario_id       Int      @unique
  token            String   @unique @db.VarChar(512)
  fecha_expiracion DateTime
  revocado         Boolean  @default(false)

  usuario          Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// MÓDULO DE DATOS MAESTROS Y CATÁLOGOS
// ==========================================

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  activo      Boolean    @default(true)

  @@map("categorias")
}

model Marca {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(100)
  activo Boolean  @default(true)

  @@map("marcas")
}

model UnidadMedida {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(50)
  activo Boolean  @default(true)

  @@map("unidades_medida")
}

model Proveedor {
  id              Int       @id @default(autoincrement())
  nombre_empresa  String    @unique @db.VarChar(200) // Obligatorio y único
  telefono        String?   @unique @db.VarChar(50)  // Opcional y único
  email           String?   @unique @db.VarChar(150) // Opcional y único
  direccion       String?   @db.VarChar(255)         // Opcional
  activo          Boolean   @default(true)
  fecha_creacion  DateTime  @default(now())

  @@map("proveedores")
}

model Cliente {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(100)        // Obligatorio
  apellido       String   @db.VarChar(100)        // Obligatorio
  documento      String?  @unique @db.VarChar(50)  // Opcional y único
  telefono       String?  @unique @db.VarChar(50)  // Opcional y único
  email          String?  @unique @db.VarChar(150) // Opcional y único
  direccion      String?  @db.VarChar(255)        // Opcional
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  @@map("clientes")
}